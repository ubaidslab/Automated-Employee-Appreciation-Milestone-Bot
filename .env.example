# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database — local SQLite file by default, zero external account needed.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./local.db
# Only needed if DATABASE_URL points at a remote Turso database instead.
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Admin panel auth (demo-grade: one shared key, not per-user accounts).
# ---------------------------------------------------------------------------
ADMIN_KEY=change-me-to-something-long-and-random
# Used to sign session cookies — a separate secret from ADMIN_KEY.
SESSION_SECRET=change-me-to-a-different-long-random-string

# ---------------------------------------------------------------------------
# Cron route auth — Vercel sends this automatically as a Bearer token when
# CRON_SECRET is set as an env var on the Vercel project. Set it here too so
# you can trigger the route manually while developing:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/check-milestones
# ---------------------------------------------------------------------------
CRON_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------------------
# Slack delivery — create an Incoming Webhook for a channel:
# https://api.slack.com/messaging/webhooks
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ---------------------------------------------------------------------------
# AI_PROVIDER selects which LLM backend generates celebration messages.
# Default: cloudflare
# ---------------------------------------------------------------------------
AI_PROVIDER=cloudflare

# --- Cloudflare Workers AI (default provider) -------------------------------
# Free tier available: https://developers.cloudflare.com/workers-ai/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_KEY=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3-8b-instruct

# --- OpenAI (optional, set AI_PROVIDER=openai to use it) --------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Message content
# ---------------------------------------------------------------------------
COMPANY_NAME=Acme Inc.
# "warm" (default, upbeat/casual) or "professional"
MESSAGE_TONE=warm

# Public URL of your deployment, used for social preview (Open Graph) images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
